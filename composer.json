{
  "name": "catalogmend/catalogmend-ai",
  "description": "Safe deterministic cleanup of corrupted WooCommerce product text.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "CatalogMend\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "find . -path ./vendor -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "config": {
    "sort-packages": true
  }
}
